# EmailJS credentials for the contact form (src/components/Contact.jsx).
# Copy this file to `.env` — which is gitignored — and fill in your own values.
# All three are readable in the shipped bundle by design; the point of putting
# them here is that rotating a key or switching to a test template is a config
# change rather than a code edit.
#
# Find them at https://dashboard.emailjs.com — Email Services, Email Templates,
# and Account > API Keys respectively.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
